# ═══════════════════════════════════════════════════════════════
#  AWS ECS Task Definitions — Robo Advisor
#  Deploy: aws ecs register-task-definition --cli-input-json file://ecs-tasks.json
# ═══════════════════════════════════════════════════════════════

{
  "taskDefinitions": [
    {
      "family": "robo-auth",
      "networkMode": "awsvpc",
      "requiresCompatibilities": ["FARGATE"],
      "cpu": "512",
      "memory": "1024",
      "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
      "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
      "containerDefinitions": [
        {
          "name": "auth",
          "image": "ghcr.io/YOUR_ORG/robo-advisor-auth:latest",
          "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
          "environment": [
            {"name": "ENVIRONMENT", "value": "production"}
          ],
          "secrets": [
            {"name": "DATABASE_URL",    "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/auth-db-url"},
            {"name": "JWT_SECRET_KEY",  "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/jwt-secret"},
            {"name": "REDIS_URL",       "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/redis-url"}
          ],
          "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
              "awslogs-group": "/ecs/robo-auth",
              "awslogs-region": "us-east-1",
              "awslogs-stream-prefix": "ecs"
            }
          },
          "healthCheck": {
            "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
            "interval": 30,
            "timeout": 5,
            "retries": 3
          }
        }
      ]
    },
    {
      "family": "robo-portfolio",
      "networkMode": "awsvpc",
      "requiresCompatibilities": ["FARGATE"],
      "cpu": "1024",
      "memory": "2048",
      "containerDefinitions": [
        {
          "name": "portfolio",
          "image": "ghcr.io/YOUR_ORG/robo-advisor-portfolio:latest",
          "portMappings": [{"containerPort": 8001, "protocol": "tcp"}],
          "secrets": [
            {"name": "DATABASE_URL",    "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/portfolio-db-url"},
            {"name": "TIMESCALE_URL",   "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/timescale-url"},
            {"name": "JWT_SECRET_KEY",  "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/jwt-secret"},
            {"name": "REDIS_URL",       "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/redis-url"}
          ],
          "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
              "awslogs-group": "/ecs/robo-portfolio",
              "awslogs-region": "us-east-1",
              "awslogs-stream-prefix": "ecs"
            }
          }
        }
      ]
    },
    {
      "family": "robo-market",
      "networkMode": "awsvpc",
      "requiresCompatibilities": ["FARGATE"],
      "cpu": "1024",
      "memory": "2048",
      "containerDefinitions": [
        {
          "name": "market-data",
          "image": "ghcr.io/YOUR_ORG/robo-advisor-market-data:latest",
          "portMappings": [{"containerPort": 8002, "protocol": "tcp"}],
          "secrets": [
            {"name": "TIMESCALE_URL",       "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/timescale-url"},
            {"name": "CELERY_BROKER_URL",   "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/redis-url"},
            {"name": "CELERY_RESULT_BACKEND","valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:robo/redis-url"}
          ]
        }
      ]
    }
  ]
}
